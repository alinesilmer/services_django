# ========================
#  Django-specific
# ========================

# SQLite database (local use)
*.sqlite3
*.db

# Django cache / logs / static generated
*.log
staticfiles/
media/
static/
tmp/
temp/

# Ignore collected static files (if collected locally)
static_root/
media_root/

# Ignore local settings (if you use them)
local_settings.py

# Django migrations (OPTIONAL)
# ✳️ Si querés ignorar migraciones locales para evitar conflicto entre equipos,
# descomentar esta línea:
# */migrations/
# ❗ OJO: si estás en un proyecto real, lo normal es *no* ignorarlas.


